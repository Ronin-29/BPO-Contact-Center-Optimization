			    "Range " & FORMAT ( LowScore, "0.00" ) & " to " & FORMAT ( HighScore, "0.00" )
			        & ": " & LowName & " lowest, " & HighName & " highest"
			)
		displayFolder: Subtitles - Quality & CSAT
		lineageTag: 52cf5bd5-6893-4440-a54a-26aa0e7f9b51

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Sub Top Box by Queue' =
			
			VAR ByQueue  = ADDCOLUMNS ( VALUES ( dim_queue[Queue_Name] ), "@Rate", [CSAT Top Box %] )
			VAR HighRate = MAXX ( ByQueue, [@Rate] )

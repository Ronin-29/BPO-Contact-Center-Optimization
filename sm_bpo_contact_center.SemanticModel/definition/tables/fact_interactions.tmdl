table fact_interactions
	lineageTag: 562cf046-34ae-4e9e-9887-04d7db2b99dc
	sourceLineageTag: [dbo].[fact_interactions]

	measure 'Total Interactions' = COUNTROWS(fact_interactions)
		formatString: 0
		lineageTag: 344651d7-785d-4013-9305-9e5bf5c18104

		changedProperty = Name

	measure 'Avg Talk Time (sec)' = AVERAGE(fact_interactions[Talk_Time_Sec])
		formatString: 0.00
		displayFolder: Time Metrics
		lineageTag: e083ae82-7a4f-4d7b-a09a-542d81753de3

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Avg Hold Time (sec)' = AVERAGE(fact_interactions[Hold_Time_Sec])
		formatString: 0.00
		displayFolder: Time Metrics
		lineageTag: 3b550885-c1f7-478f-a64b-997eb2c427ee

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Avg Handle Time (sec)' = AVERAGE(fact_interactions[handle_time_sec])
		formatString: 0.00
		displayFolder: Time Metrics
		lineageTag: 79f7e9a0-fe1f-4327-a961-6537cae36544

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Avg CSAT' = AVERAGE(fact_interactions[CSAT_Rating])
		formatString: 0.00
		displayFolder: Customer Satisfaction
		lineageTag: 830a8188-df1f-4e5f-8e47-744c23463048

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

	measure 'Rated Interactions' = COUNT(fact_interactions[CSAT_Rating])
		formatString: 0
		displayFolder: Customer Satisfaction
		lineageTag: 94787b1b-4bc6-4941-9e15-c33c25c1bcf6

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Resolved Interactions' = CALCULATE([Total Interactions], fact_interactions[Status] = "Resolved")
		formatString: 0
		displayFolder: Outcomes
		lineageTag: a5b8d583-0416-463c-ac0e-71414bb25df8

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Resolution Rate' = DIVIDE([Resolved Interactions], [Total Interactions])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Outcomes
		lineageTag: 6916670a-3f7c-477b-8337-fdff46a2b803

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Abandoned Interactions' = CALCULATE([Total Interactions], fact_interactions[Status] = "Abandoned")
		formatString: 0
		displayFolder: Outcomes
		lineageTag: a1abdc88-7504-4509-a84d-3fe958488906

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Abandonment Rate' = DIVIDE([Abandoned Interactions], [Total Interactions])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Outcomes
		lineageTag: f656efec-4c49-432a-b221-1ecef7cb70dc

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'CSAT Top Box %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_interactions), fact_interactions[CSAT_Rating] >= 4),
			    [Rated Interactions]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Customer Satisfaction
		lineageTag: c9729425-d8da-4936-a9e2-5b1b8798b4ba

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

